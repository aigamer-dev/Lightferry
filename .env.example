# Lightferry works with no key and no flag. These variables are only needed with --encrypt.
# Never commit a real key; no secret belongs in this file.
#
# Option A: a key file made with `lightferry keygen --out lightferry.key` (mode 600, git-ignored),
# carried to the other machine by hand. 64 hex chars or @path to the file:
# LIGHTFERRY_KEY=@lightferry.key
#
# Option B: a shared passphrase (12+ characters), the same on both machines:
# LIGHTFERRY_PASSPHRASE=
#
# Debug: print camera diagnostics and save undecodable frames
# LIGHTFERRY_DEBUG=1
